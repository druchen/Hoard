{
  "manifest_version": 3,
  "name": "Hoard",
  "short_name": "Hoard",
  "version": "1.2.7",
  "description": "Save images from the web to your local reference folders as WebP. Right-click an image or press H.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "https://shotdeck.com/*",
    "https://*.artstation.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon48.png"
  },
  "content_scripts": [
    {
      "matches": ["*://shotdeck.com/*"],
      "js": ["hoard-common.js", "sd.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.artstation.com/*",
        "*://artstation.com/*"
      ],
      "js": ["hoard-common.js", "artstation.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
