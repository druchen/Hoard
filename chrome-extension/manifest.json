{
  "manifest_version": 3,
  "name": "Hoard",
  "short_name": "Hoard",
  "version": "1.3.0",
  "description": "Save images from any website to your local reference folders as WebP. Right-click an image or press H.",
  "permissions": [
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "hoard-common.js",
        "sd.js",
        "artstation.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
