{
  "manifest_version": 3,
  "name": "Hoard",
  "short_name": "Hoard",
  "version": "1.5.0",
  "description": "Save images from any website to your own folders, with shortcut keys. WebP, JPEG or PNG.",
  "permissions": [
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Hoard settings",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "hoard-settings.js",
        "hoard-common.js",
        "sd.js",
        "artstation.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
